# Copy this file to .env.local and fill in the values (never commit .env.local).
# Supabase Dashboard -> Project Settings -> API

# Project URL, e.g. https://abcdxyz.supabase.co
VITE_SUPABASE_URL=

# "anon public" key (NOT the service_role key)
VITE_SUPABASE_ANON_KEY=

# Optional: Google reCAPTCHA v3 *site* key (leave empty to disable)
VITE_RECAPTCHA_SITE_KEY=

# Optional: your live domain, used only when generating sitemap.xml at build time
SITE_URL=https://agriverse.in
